    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter verwendet das Mikrofon nur, um deiner Stimme zu folgen und den Text zu scrollen, während du sprichst. Audiodaten werden auf deinem Mac verarbeitet und niemals aufgenommen, gespeichert oder übertragen. Der Zugriff wird erst beim Aktivieren der Sprachsteuerung angefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter uses the microphone only to follow your voice and scroll the prompter while you speak. Audio is processed on your Mac and never recorded, saved, or sent anywhere. This is requested only when you turn on voice-follow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter solo utiliza el micrófono para seguir tu voz y desplazar el texto mientras hablas. El audio se procesa en el Mac y nunca se graba, se guarda ni se envía a ningún sitio. Este permiso solo se solicita al activar el seguimiento de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter utilise le microphone uniquement pour suivre votre voix et faire défiler le texte pendant que vous parlez. Le son est traité sur votre Mac et ne fait jamais l’objet d’un enregistrement, d’une sauvegarde ou d’un envoi. Cette autorisation est demandée uniquement lorsque vous activez le suivi vocal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchPrompter usa o microfone apenas para acompanhar sua voz e rolar o texto enquanto você fala. O Mac processa o áudio localmente, sem gravar, salvar ou enviar nada. O app só solicita essa permissão quando você ativa o acompanhamento por voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter использует микрофон только для слежения за голосом и прокрутки телесуфлёра, пока вы говорите. Аудио обрабатывается на вашем Mac и никогда не записывается, не сохраняется и никуда не отправляется. Доступ запрашивается только при включении слежения за голосом."
          }
        }
      }
    }
  },
  "version" : "1.3"
}