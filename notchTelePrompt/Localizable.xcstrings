    "Voice-follow needs microphone access. Open System Settings to turn it on, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachsteuerung benötigt Mikrofonzugriff. Öffne die Systemeinstellungen, um ihn zu erlauben, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento de voz necesita acceso al micrófono. Abre Ajustes del Sistema para activarlo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi vocal nécessite l’accès au microphone. Ouvrez les réglages système pour l’autoriser, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acompanhamento por voz precisa de acesso ao microfone. Abra os Ajustes do Sistema para ativá-lo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для слежения за голосом нужен доступ к микрофону. Откройте системные настройки, чтобы разрешить его, и повторите попытку."
          }
        }
      }
    },
